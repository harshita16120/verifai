# VerifAI Environment Variables

# Admin Auth & Passphrase
ADMIN_PASSWORD=admin123
JWT_SECRET=verifai-secret-key-change-in-production-2026

# Local ML Model Settings
VERIFAI_MODEL=models/deepfake_detector.pth

# ------------------------------------------------------------------------------
# Optional Free-Tier Hosted AI APIs (Env-Gated: App works without any key)
# ------------------------------------------------------------------------------

# Slot 1: Plain-English Verdict & Layman Summary Generator
# Alternative A: Google AI Studio (Gemini 1.5 Flash - Free Tier: 15 RPM, 1M TPM)
# Alternative B: OpenRouter (Free models: meta-llama/llama-3.1-8b-instruct:free)
# Alternative C: Mistral API (Free tier codestral/mistral-tiny)
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=

# Slot 2: Hosted Second-Opinion Deepfake Classifier
# Alternative A: Hugging Face Inference API (Free Tier: 1,000 requests/day)
# Alternative B: Replicate (Free trial credits for ViT deepfake models)
HUGGINGFACE_API_KEY=
